+def _required_lines(citation, root, files):
+    """Ignore only structural Python blank lines in an exact frozen source snapshot.
+
+    String-literal whitespace, prose, unparseable Python and unknown token forms
+    remain required. No source text is rewritten or compared after normalization.
+    """
+    numbers = range(citation['start'], citation['end'] + 1)
+    if root is None and files is None:
+        return numbers  # Backward-compatible strict coverage without source context.
+    if root is None or not isinstance(files, dict):
+        return None
+    name = citation.get('path')
+    if not isinstance(name, str) or name not in files:
+        return None
+    relative = Path(name)
+    if relative.is_absolute() or relative.drive or '..' in relative.parts:
+        return None
+    original_root = Path(root).absolute()
+    original = original_root / relative
+    try:
+        if any(p.is_symlink() or (hasattr(p, 'is_junction') and p.is_junction())
+               for p in (original, *original.parents) if p.is_relative_to(original_root)):
+            return None
+        path = original.resolve(strict=True)
+        if not path.is_relative_to(original_root.resolve(strict=True)) or not path.is_file():
+            return None
+        if path.stat().st_size > 1048576:
+            return None
+        raw = path.read_bytes()
+        if hashlib.sha256(raw).hexdigest() != files[name]:
+            return None
+        text = raw.decode('utf-8')
+        lines = text.splitlines()
+        if citation['end'] > len(lines):
+            return None
+        if path.suffix != '.py':
+            return numbers
+        try:
+            ast.parse(text)
+            tokens = list(tokenize.generate_tokens(io.StringIO(text).readline))
+        except (SyntaxError, ValueError, tokenize.TokenError):
