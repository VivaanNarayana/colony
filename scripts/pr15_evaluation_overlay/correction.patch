+        # Newer Python versions tokenize interpolated strings differently. Retain
+        # strict coverage for those rather than guessing which whitespace matters.
+        if any(tokenize.tok_name.get(t.type, '').startswith(('FSTRING', 'TSTRING'))
+               for t in tokens):
