+        string_lines = {n for t in tokens if t.type == tokenize.STRING
+                        for n in range(t.start[0], t.end[0] + 1)}
+        return {n for n in numbers if lines[n - 1].strip() or n in string_lines}
+    except (OSError, UnicodeError, ValueError):
+        return None
